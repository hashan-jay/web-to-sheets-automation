# Copy this file to .env and fill in the values.

# Admin dashboard
DASHBOARD_URL=https://skgaming16.as6868.com/#transactions
USE_OPEN_BROWSER=false
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Optional one-time 6-digit code. Prefer typing the live Authenticator code in the opened browser.
DASHBOARD_2FA=

# Up to 3 saved GUI login accounts. Active slot is used on Run now.
# Each website+username keeps its own scrape/sent database and Google Sheets
# under data/sites/. A new website starts with empty records.
LOGIN_ACTIVE_SLOT=1
LOGIN_1_URL=
LOGIN_1_USERNAME=
LOGIN_1_PASSWORD=
LOGIN_1_2FA=
LOGIN_2_URL=
LOGIN_2_USERNAME=
LOGIN_2_PASSWORD=
LOGIN_2_2FA=
LOGIN_3_URL=
LOGIN_3_USERNAME=
LOGIN_3_PASSWORD=
LOGIN_3_2FA=

# Optional: pause so you can complete 2FA or captcha in the opened browser
MANUAL_LOGIN_SECONDS=0

# Search filters. Status is always Completed so the Record count matches the site.
FILTER_DATE_FROM=
FILTER_DATE_TO=
FILTER_TYPE=ACTIVE
FILTER_STATUS=COMPLETED

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_ID_2=
GOOGLE_SHEET_ID_3=
GOOGLE_SHEET_ID_4=
GOOGLE_SHEET_ID_5=
GOOGLE_WORKSHEET=
GOOGLE_CREDENTIALS_PATH=credentials/service-account.json

# Values that are dropdowns on the sheet and not always on the card
DEFAULT_BANK_ACCOUNT=ANZPLUS O'NEILL R W
# Exact Google Sheet BANK dropdown labels. Deposits match ATTACHMENT screenshots
# to these, plus any BANK values already on the sheet. Withdrawals stay blank.
# Separate multiple accounts with | (preferred) or commas.
BANK_ACCOUNTS=ANZPLUS O'NEILL R W
DEFAULT_BRAND=FUCKSPIN
DEFAULT_STAFF_CODE=SL0017
ALLOWED_BRANDS=POKIESPARK,FUCKSPIN,JOINTMATE,HITMATE88,AUZBETS,WEMETH
BRAND_ALIASES=FUCKSPINVIPA:FUCKSPIN,FUCKSPINVIPC:FUCKSPIN

# Browser
HEADED=true
SLOW_MO_MS=0
MAX_PAGES=200
# After a saved login, read Completed over HTTP instead of paging Chrome.
# Set false only if you need the old click-through scrape.
USE_DASHBOARD_API=true

# GUI watcher: how often to poll the dashboard for new notifications
POLL_INTERVAL_SECONDS=60
GUI_THEME=light
